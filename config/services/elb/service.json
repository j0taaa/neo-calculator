          "field": "type",
          "equals": "Dedicated load balancer"
        },
        {
          "field": "specificationType",
          "equals": "Elastic"
        }
      ]
    },
    {
      "id": "tcpNewConnections",
      "type": "number",
      "label": "TCP New Connections",
      "required": true,
      "unit": "per second",
      "min": 0,
