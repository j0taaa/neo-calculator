{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neocalculator.local/schemas/service-registry.schema.json",
  "title": "NeoCalculator Service Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services", "supportedCalculatorServiceCodes", "supportedBatchAddServiceCodes", "definitions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "code", "icon"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "supportedCalculatorServiceCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supportedBatchAddServiceCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceCode", "definitionId", "serviceDefinitionPath", "pricingDefinitionPath", "status"],
        "properties": {
          "serviceCode": {
            "type": "string",
            "minLength": 1
          },
          "definitionId": {
            "type": "string",
            "minLength": 1
          },
          "serviceDefinitionPath": {
            "type": "string",
            "minLength": 1
          },
          "pricingDefinitionPath": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pilot", "active", "deprecated"]
          }
        }
      }
    }
  }
}
