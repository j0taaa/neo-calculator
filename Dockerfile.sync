FROM oven/bun:1.3.10
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl nodejs && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
RUN bunx playwright install --with-deps chromium
COPY tsconfig.json ./
COPY lib ./lib
COPY scripts/build-snapshot-bridge.ts scripts/sync-calculator-snapshot.ts scripts/run-calculator-sync.ts ./scripts/
RUN bun run scripts/build-snapshot-bridge.ts
ENV HUAWEI_SOURCE_DB=/app/snapshots/sources.sqlite
ENV HUAWEI_SNAPSHOT_DIR=/app/snapshots
ENV HUAWEI_SOURCE_ACCESS=sync
RUN mkdir -p /app/snapshots
CMD ["bun", "run", "scripts/run-calculator-sync.ts"]
