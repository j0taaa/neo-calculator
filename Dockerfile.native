FROM oven/bun:1.3.10
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl nodejs && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
RUN bunx playwright install --with-deps chromium
COPY tsconfig.json ./
COPY lib ./lib
COPY scripts/serve-native-calculator.ts ./scripts/serve-native-calculator.ts
ENV HUAWEI_SYNC_DB=/app/data/native.sqlite
RUN mkdir -p /app/data
CMD ["bun", "run", "scripts/serve-native-calculator.ts"]
