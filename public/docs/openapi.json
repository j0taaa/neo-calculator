{
  "openapi": "3.1.0",
  "info": {
    "title": "NeoCalculator API",
    "description": "API for NeoCalculator - A better version of the Huawei Cloud calculator. Use this API to access pricing information and manage your projects and lists programmatically.",
    "version": "1.0.0",
    "contact": {
      "name": "NeoCalculator Support"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current version"
    }
  ],
  "tags": [
    {
      "name": "Public",
      "description": "Public endpoints that do not require authentication"
    },
    {
      "name": "Private",
      "description": "Private endpoints that require an API key"
    }
  ],
  "paths": {
    "/public/catalog/{service}/pricing": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get pricing catalog for a service",
        "description": "Compatibility alias for /public/catalog/{service}. Use the canonical catalog URL advertised by service discovery.",
        "operationId": "getServicePricingCompatibility",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "description": "The service code (e.g., vpn, cce, eip)",
            "schema": {
              "type": "string",
              "example": "vpn"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "The Huawei region ID or legacy region alias; defaults to the first available region for this service",
            "schema": {
              "type": "string",
              "example": "la-sao-paulo1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "example": "vpn"
                    },
                    "region": {
                      "type": "string",
                      "example": "la-sao-paulo1"
                    },
                    "catalogRegionId": {
                      "type": "string",
                      "example": "sa-brazil-1"
                    },
                    "catalog": {
                      "type": "object",
                      "description": "The pricing catalog for the service. Structure varies by service."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid region or service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Service not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/calculate": {
      "post": {
        "tags": [
          "Private"
        ],
        "summary": "Recalculate configurations from the daily synchronized snapshot",
        "description": "Reconstructs complete prices using the same offline engine as saving. Provide durable config.selection and config.local from the local calculator, not a flat legacy configuration. Client prices and top-level quantities are ignored; quantity is derived and validated against the pricing components. One snapshot is used for the entire batch. Current rates are used; changed conditional rules require reopening the configuration. Supports every published service and its available billing modes.",
        "operationId": "calculateSnapshotProducts",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "products"
                ],
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "Optional region constraint, validated against every product; no implicit region fallback."
                  },
                  "products": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "serviceCode",
                        "config"
                      ],
                      "properties": {
                        "serviceCode": {
                          "type": "string",
                          "example": "HUAWEI:ecs"
                        },
                        "config": {
                          "type": "object",
                          "description": "The complete config emitted by the local calculator, including selection and local."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every product was priced; results include numeric pricing.amount, currency, breakdown and any RI payment schedule."
          },
          "207": {
            "description": "Mixed batch: successful prices and per-product errors; failed entries have pricing:null."
          },
          "400": {
            "description": "Malformed product/body, invalid region or batch size."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "422": {
            "description": "No products could be verified; results contain per-product errors."
          },
          "503": {
            "description": "No published snapshot is available."
          }
        }
      }
    },
    "/public/services": {
      "get": {
        "tags": ["Public"],
        "summary": "List all available services",
        "description": "Returns a list of all services available in the calculator with their codes, names, and categories.",
        "operationId": "listServices",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": { "type": "string", "example": "vpn" },
                          "name": { "type": "string", "example": "Virtual Private Network" },
                          "category": { "type": "string", "example": "Networking" },
                          "pricingUrl": { "type": "string", "example": "/api/v1/public/catalog/vpn/pricing" }
                        }
                      }
                    },
                    "total": { "type": "integer", "example": 24 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/regions": {
      "get": {
        "tags": ["Public"],
        "summary": "List all available regions",
        "description": "Returns a list of all Huawei Cloud regions available in the calculator.",
        "operationId": "listRegions",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "regions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": { "type": "string", "example": "la-sao-paulo1" },
                          "short": { "type": "string", "example": "LA-Sao Paulo1" },
                          "full": { "type": "string", "example": "Sao Paulo, Brazil (1)" },
                          "catalogRegionId": { "type": "string", "example": "sa-brazil-1", "nullable": true }
                        }
                      }
                    },
                    "total": { "type": "integer", "example": 24 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/catalog/{service}": {
      "get": {
        "tags": ["Public"],
        "summary": "Get pricing catalog for a service",
        "description": "Reads the synchronized catalog and conditional configuration for a service and region. Service aliases and HUAWEI:<id> codes are accepted. Unknown regions are rejected instead of silently selecting another region.",
        "operationId": "getServicePricing",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "description": "The service code (e.g., vpn, cce, eip)",
            "schema": {
              "type": "string",
              "example": "vpn"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "The Huawei region ID or legacy region alias; defaults to the first available region for this service",
            "schema": {
              "type": "string",
              "example": "la-sao-paulo1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string", "example": "vpn" },
                    "region": { "type": "string", "example": "la-sao-paulo1" },
                    "catalogRegionId": { "type": "string", "example": "sa-brazil-1" },
                    "catalog": {
                      "type": "object",
                      "description": "The pricing catalog for the service. Structure varies by service."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid region or service",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Service not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/public/services/{serviceCode}/schema": {
      "get": {
        "tags": ["Public"],
        "summary": "Get the JSON Schema for a service product body",
        "description": "Returns the synchronized calculator workflow and the JSON schema for a durable local configuration. All published services and billing modes use config.region, config.billingMode, config.selection and config.local. Legacy service aliases resolve to the canonical HUAWEI:<id> service. No server browser session is used.",
        "operationId": "getServiceSchema",
        "parameters": [
          {
            "name": "serviceCode",
            "in": "path",
            "required": true,
            "description": "The service alias or canonical HUAWEI:<id> code",
            "schema": {
              "type": "string",
              "example": "dcs"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with synchronized calculator metadata and JSON Schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "serviceCode": { "type": "string", "example": "HUAWEI:redis" },
                    "serviceName": { "type": "string", "example": "Distributed Cache Service (for Redis)" },
                    "productType": { "type": "string", "example": "huawei-native" },
                    "releaseId": { "type": "string" },
                    "calculator": { "type": "object", "description": "Offline workflow URLs and billing availability by region." },
                    "schema": { "type": "object", "description": "Schema for a durable local configuration." }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown service code or service has no schema",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Error" },
                    {
                      "type": "object",
                      "properties": {
                        "error": { "type": "string" },
                        "availableServices": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
